# ─── copy to .env, then `pnpm infra:up && pnpm db:migrate` ────────────────────

# API
PORT=4000
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
# NODE_ENV is deliberately not set here. The tooling sets it per command, and a
# `source .env` before `pnpm build` would otherwise pin a production build to
# development mode.

# Postgres (docker-compose maps 5433 to avoid clashing with a local postgres)
DATABASE_URL=postgres://specd:specd@localhost:5433/specd

# Auth — change both in any non-local environment
JWT_SECRET=dev-only-jwt-secret-change-me
# 32-byte master key for the credential vault (envelope encryption).
# Generate: openssl rand -base64 32
VAULT_MASTER_KEY=ZGV2LW9ubHktdmF1bHQta2V5LWNoYW5nZS1tZS0zMmI=

# ─── AI ───────────────────────────────────────────────────────────────────────
# The onboarding agent and SpecAgent call Claude for real. Without a key the
# platform still runs; agent runs fail with a clear, honest error.
ANTHROPIC_API_KEY=
# Platform default. Allowlist: claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5
SPECD_DEFAULT_MODEL=claude-opus-5
# EUR per USD, used to meter AgentRun.cost_eur from the model's USD rates.
SPECD_USD_TO_EUR=0.92

# ─── Knowledge index ──────────────────────────────────────────────────────────
# hash   = deterministic local embedder, zero extra keys, works offline.
#          Retrieval quality is carried by Postgres full-text search.
# voyage = real dense embeddings (Anthropic's recommended embedding partner).
#          Requires VOYAGE_API_KEY; the API refuses to start without it rather
#          than falling back to hash behind your back.
# openai = any OpenAI-compatible /v1/embeddings endpoint — Ollama, LM Studio,
#          llama.cpp, vLLM, or OpenAI itself. Pointing this at localhost is how
#          a local-first install gets real semantic retrieval without sending a
#          repository's knowledge anywhere.
# Switching provider re-embeds every doc on the next index run — the two
# produce different vector spaces, and mixing them makes distances meaningless.
SPECD_EMBEDDING_PROVIDER=hash
VOYAGE_API_KEY=

# For SPECD_EMBEDDING_PROVIDER=openai. The model must produce 1024-dimension
# vectors, because that is the width of the pgvector column — the API probes
# the endpoint at startup and refuses a mismatch by name, rather than failing
# on an insert halfway through the first index run.
#   ollama pull mxbai-embed-large   # 1024 ✓
#   nomic-embed-text is 768 and will be refused.
SPECD_EMBEDDING_BASE_URL=http://localhost:11434/v1
SPECD_EMBEDDING_MODEL=mxbai-embed-large
SPECD_EMBEDDING_API_KEY=

# ─── Local mode ───────────────────────────────────────────────────────────────
# Root the local-git VCS adapter is allowed to touch. Repo paths registered via
# `specd connect` must live under this directory.
SPECD_LOCAL_REPO_ROOT=
# May a local-mode branch be pushed to its own `origin` and opened as a real
# PR/MR? It uses the `gh`/`glab` already signed in on this machine — specd holds
# no host token in local mode and never will (knowledge/decisions/0020-…).
# Set to 0 where this machine has a remote it must not publish to; the branch is
# still committed locally either way. Default: 1.
SPECD_LOCAL_OPEN_PR=1

# ─── GitHub App (optional — local git mode needs none of it) ──────────────────
# Register in one click with the API running:  <API_PUBLIC_URL>/api/github/app/register
# Full walkthrough, including webhook forwarding for local dev: docs/github-app.md
#
# The App asks for contents:write, pull_requests:write and metadata:read —
# enough to push branches and open PRs, and nothing else. specd never pushes to
# your default branch.
GITHUB_APP_ID=
GITHUB_APP_SLUG=specd
# The .pem GitHub generated. Real newlines or \n escapes both work; keep the quotes.
GITHUB_APP_PRIVATE_KEY=
# Required for webhooks. Leaving it empty REJECTS every delivery — it never
# means "skip the signature check", so a forgotten value cannot open a hole.
# Using `gh webhook forward`? Put the secret *it* prints here instead.
GITHUB_WEBHOOK_SECRET=

# Scratch root for hosted build clones. Each run gets its own directory under
# this and deletes it afterwards. Defaults to the system temp dir.
SPECD_BUILD_ROOT=

# Index worker (0012). A merge queues an index run and a worker in the API
# process executes it, woken by Postgres LISTEN/NOTIFY — so a webhook returns
# in the time it takes to write one row. The tick below is only a backstop for
# a dropped listen connection; it is not how work normally starts.
# SPECD_INDEX_WORKER_ENABLED=true
# SPECD_INDEX_POLL_MS=60000
# SPECD_INDEX_LEASE_SECONDS=900

# Webhook delivery retention (S-103). Delivery rows are the audit trail for
# "why did specd do that last week" — pruned by age, daily and at startup.
# SPECD_WEBHOOK_RETENTION_DAYS=30
# SPECD_WEBHOOK_PRUNE_INTERVAL_MS=86400000

# Runner job leases (S-101). A dispatched job whose runner stops heartbeating
# becomes claimable again after its kind's lease; after MAX_RECLAIMS takeovers
# it is failed as repeatedly abandoned. Defaults: 180 / 900 / 3.
# SPECD_RUNNER_LEASE_SECONDS=180
# SPECD_RUNNER_LEASE_BUILD_SECONDS=900
# SPECD_RUNNER_MAX_RECLAIMS=3

# GitHub Enterprise Server only — point these at your host.
# GITHUB_API_BASE=https://github.example.com/api/v3
# GITHUB_BASE=https://github.example.com
# GITHUB_CLONE_BASE=https://github.example.com

# ─── GitLab (optional) ─────────────────────────────────────────────────────────
# No app to register: connect a project with a personal/project access token
# (`api` scope) via the wizard or `POST /projects/:slug/connections/vcs`
# (`provider: "gitlab"`, `token`, and `instanceUrl` for self-managed — omit
# instanceUrl for gitlab.com). specd registers a webhook on each repository you
# add, using the token below. Full walkthrough: docs/gitlab.md
#
# Required for webhooks. Leaving it empty REJECTS every delivery — same rule as
# GITHUB_WEBHOOK_SECRET, for the same reason: "unset" must never mean "skip it".
GITLAB_WEBHOOK_SECRET=
