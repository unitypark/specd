{
  "name": "@specd/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import @swc-node/register/esm-register src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "node --import @swc-node/register/esm-register src/seed.ts",
    "loop": "node --import @swc-node/register/esm-register src/e2e-loop.ts",
    "test": "vitest run",
    "seed:demo": "node --import @swc-node/register/esm-register src/seed-demo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@specd/db": "workspace:*",
    "@specd/shared": "workspace:*",
    "@specd/templates": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.8",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.15.47",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.23.11",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "license": "MIT"
}
