{
  "name": "@specd/runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "specd-runner": "./dist/main.js"
  },
  "scripts": {
    "dev": "node --watch --import @swc-node/register/esm-register src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@specd/shared": "workspace:*"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.15.47",
    "@types/node": "^22.10.2",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  },
  "license": "MIT"
}
